# DealGate web — sample environment.
#
# Copy this to `.env.local` for local dev. Leave the VITE_COGNITO_* vars
# empty (or unset) to run against the FastAPI dev auth backend using the
# `X-Test-User` header from VITE_TEST_USER.

# --- API base URL ----------------------------------------------------------
# FastAPI dev server default. Prod build gets this from the deploy env.
VITE_API_BASE_URL=http://localhost:8000

# --- Local dev auth fallback (dev only) ------------------------------------
# When VITE_COGNITO_* is empty, the client sends this value as `X-Test-User`
# so the FastAPI dev auth backend picks a role. Ignored in prod builds.
VITE_TEST_USER=

# --- Cognito hosted UI (prod / staging) ------------------------------------
# When any of these are set, the app switches to the real Cognito flow. In
# prod these are injected by GitHub Actions from repo secrets of the same
# name — see .github/workflows/README.md.

# Hosted-UI domain, e.g. https://officeapp-dev.auth.us-east-2.amazoncognito.com
VITE_COGNITO_DOMAIN=

# App client ID of the SPA client (no client secret — PKCE).
VITE_COGNITO_CLIENT_ID=

# Where Cognito redirects after login. Must match an allowed callback URL
# on the app client. Defaults at runtime to `${origin}/auth/callback`.
VITE_COGNITO_REDIRECT_URI=

# Where Cognito redirects after sign-out. Must match an allowed sign-out URL
# on the app client. Defaults at runtime to `${origin}`.
VITE_COGNITO_LOGOUT_URI=
