# Production build config.
#
# Everything here is deliberately host-agnostic: the same bundle is served from
# d1mu2un4hj9akj.cloudfront.net and from dealgate.smartek21.com, and hardcoding
# either hostname breaks it on the other.
#
# API base is a relative path. CloudFront routes /api/* to the ALB origin and
# everything else to the S3 origin, so the API is same-origin with the SPA on
# every hostname the distribution answers to. An absolute URL here would make
# every API call cross-origin the moment the domain changed — and the API has
# no CORS middleware, so it would fail rather than degrade.
VITE_API_BASE_URL=/api

VITE_COGNITO_DOMAIN=https://officeapp-dev-405473.auth.us-east-2.amazoncognito.com
VITE_COGNITO_CLIENT_ID=dg2b6dhiu126bq459tthcmso2

# VITE_COGNITO_REDIRECT_URI and VITE_COGNITO_LOGOUT_URI are intentionally unset.
# web/src/auth/cognito.ts falls back to window.location.origin, which is what we
# want: log in on whichever host you loaded, come back to that same host.
#
# Do not "document" them by setting them to an empty string — the fallback is a
# `??`, and "" is not nullish, so a blank value yields a blank redirect_uri and
# Cognito rejects the authorize call. Leave the keys out entirely.
