{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "@playwright/test"],
    "noEmit": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["playwright.config.ts", "fixtures/**/*.ts", "specs/**/*.ts"]
}
