# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Node
node_modules/
web/dist/
web/.vite/
*.log

# Env / secrets
.env
.env.*
!.env.example

# web/.env.production is build configuration, not secrets, and it must be in
# the repo: deploy.yml runs `npm run build` on a CI checkout, so without this
# file Vite silently falls back to VITE_API_BASE_URL=http://localhost:8000 and
# an empty Cognito client id. The build stays green and the bundle is dead —
# every API call to localhost, no login possible. Verified by building without
# it. Nothing in the file is secret: the Cognito SPA client has
# generate_secret = false and its id is served inside the bundle regardless.
!web/.env.production
secrets/
# Restored 22 Sep 2026 (s14a.1): the infra-tf/modules/secrets/ Terraform
# module is not a secret — it declares Secrets Manager resources whose
# values are populated at apply time. Ignoring it hid a whole module from
# git for months and turned every fresh checkout into an unreadable-module
# error.
!infra-tf/modules/secrets/
*.pem
*.key

# CDK
cdk.out/
infra/node_modules/

# Terraform
infra-tf/.terraform/
infra-tf/.terraform.lock.hcl
infra-tf/*.tfstate
infra-tf/*.tfstate.*
infra-tf/*.tfvars
!infra-tf/*.tfvars.example
infra-tf/crash.log
# S14a.1 bootstrap keeps LOCAL state on purpose (it owns the S3 bucket
# that holds every other root's state). Commit its state so the next
# operator can plan/import/destroy it without re-bootstrapping.
!infra-tf/bootstrap/terraform.tfstate
!infra-tf/bootstrap/terraform.tfstate.*

# TypeScript build info
web/tsconfig.tsbuildinfo

# OS
.DS_Store

# Editor
.vscode/
.idea/
api/dev.db
